PORT=3000
# Google Cloud Console -> enable "Maps JavaScript API" + "Places API", restrict key to your domain
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Token needed to change an issue's status (admin / municipal staff)
ADMIN_TOKEN=change-this-secret
# Default map centre
DEFAULT_LAT=28.6139
DEFAULT_LNG=77.2090
